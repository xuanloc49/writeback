{
  "name": "writeback",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "build:shared": "pnpm --filter @writeback/shared build",
    "typecheck": "pnpm build:shared && pnpm -r --if-present typecheck",
    "test": "pnpm build:shared && pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @writeback/api prisma:migrate:dev",
    "db:seed": "pnpm --filter @writeback/api prisma:seed",
    "promote-admin": "pnpm --filter @writeback/api promote-admin"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.35.0"
  }
}
