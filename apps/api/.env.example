# WriteBack API environment (design §16). Copy to .env for local development.
# Local Docker services: see docker-compose.yml (Postgres on 5433, Redis on 6380).

# Infrastructure
DATABASE_URL=postgresql://writeback:writeback@localhost:5433/writeback?schema=public
REDIS_URL=redis://localhost:6380

# Runtime
APP_ENV=local
NODE_ENV=development
PORT=4000
BUSINESS_TZ=Asia/Ho_Chi_Minh

# Web origin / cookies
APP_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=

# Auth.js (Google) — design §3.1 / §6.0. Mounted on the API at /auth/* (no /v1 prefix).
# AUTH_URL = public origin of the API (Fly: https://api.<root>); Auth.js builds redirects from it.
# Google Cloud Console → OAuth client → Authorized redirect URI: <AUTH_URL>/auth/callback/google
# AUTH_SECRET: random >= 32 chars (e.g. `openssl rand -hex 32`). Required outside local/test;
# blank in local/test falls back to a fixed development secret (warning logged at boot).
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET may stay blank in local/test only (Google sign-in then fails
# at Google with an invalid client_id; every other /auth route still works).
AUTH_URL=http://localhost:4000
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Beta allowlist (seed only)
BETA_ALLOWLIST_ENABLED=false
BETA_ALLOWLIST_EMAILS=

# Legal document versions
TOS_VERSION=1
PRIVACY_VERSION=1

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_PRICE_IN=0.15
OPENAI_PRICE_OUT=0.60
OPENAI_DATA_HANDLING=zero_retention
OPENAI_MAX_OUTPUT_TOKENS=1200
DAILY_AI_BUDGET_USD=5
SCORING_PROMPT_VERSION=score.v1

# Rate limiting (Redis)
RATE_LIMIT_SUBMIT_PER_MIN=10
RATE_LIMIT_START_PER_MIN=20

# Observability
SENTRY_DSN=
