# WriteBack API test environment (committed, no secrets). Loaded by test/setup-env.ts.
# Uses the second Docker database created by docker/postgres/init.sql.

# Infrastructure
DATABASE_URL=postgresql://writeback:writeback@localhost:5433/writeback_test?schema=public
REDIS_URL=redis://localhost:6380

# Runtime
APP_ENV=test
NODE_ENV=test
PORT=4000
BUSINESS_TZ=Asia/Ho_Chi_Minh

# Web origin / cookies
APP_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=

# Auth.js (Google) — placeholder credentials; sign-in tests only assert the redirect to Google.
AUTH_URL=http://localhost:4000
AUTH_SECRET=test-secret-not-for-production
AUTH_GOOGLE_ID=test-google-client-id
AUTH_GOOGLE_SECRET=test-google-client-secret

# Beta allowlist (seed only)
BETA_ALLOWLIST_ENABLED=false
BETA_ALLOWLIST_EMAILS=

# Legal document versions
TOS_VERSION=1
PRIVACY_VERSION=1

# OpenAI (empty key on purpose: tests use a fake provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_PRICE_IN=0
OPENAI_PRICE_OUT=0
OPENAI_DATA_HANDLING=zero_retention
OPENAI_MAX_OUTPUT_TOKENS=1200
DAILY_AI_BUDGET_USD=1
SCORING_PROMPT_VERSION=score.v1

# Rate limiting (Redis)
RATE_LIMIT_SUBMIT_PER_MIN=10
RATE_LIMIT_START_PER_MIN=20

# Observability
SENTRY_DSN=
